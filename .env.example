# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# Socket Mode を使う場合（ローカル開発向け）
SLACK_APP_TOKEN=xapp-...
# 公開チャンネル（回答掲載先）
SLACK_CHANNEL_ID=C...

# 送信先ユーザー ID の HMAC 用。openssl rand -hex 32 で生成する
HMAC_SECRET=

# 管理画面（sottoq-admin）向け。未設定なら /admin は無効
ADMIN_API_TOKEN=

# Database
DATABASE_URL=mysql://app:app@127.0.0.1:3306/sottoq

# App
PORT=3000
TZ=Asia/Tokyo
# 1 で Socket Mode、未設定または 0 で HTTP Request URL。本番は 0
SLACK_SOCKET_MODE=0
