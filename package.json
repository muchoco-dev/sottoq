{
  "name": "anonymous-question-slack-app",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "匿名で質問・回答できる Slack アプリ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "job:send": "tsx src/cli.ts send",
    "job:post": "tsx src/cli.ts post",
    "job:close": "tsx src/cli.ts close"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@slack/bolt": "^4.4.0",
    "dotenv": "^16.6.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
